@INPROCEEDINGS{10808739,
bibtex_show={true},
preview={APCCAS-Apurv.png},
abbr={APCCAS},
award_name={About this paper},
award={True random number generators serve as a fundamental primitive in cryptpgraphic key generators. 
Finite bandwidth, circuit mismatches, limited gain of extraction circuits are some
challenges for hardware implementation of TRNG circuits. Most reported implementations use heavy post processing or combine data from mulitple instances for realization of high quality random numbers. In this work, we show that the multiple uncorrelated noise sources of a continuous time delta sigma modulator can be harvested to generate high quality radom numbers thereby reducing the amount of post processing neeed. We discuss the noise transfer functions from various noise sources in the loop and the circuit design to ensure all noise sources have similar variance so as to get high entropy.},
website={https://doi.org/10.1109/APCCAS62602.2024.10808739},
author={Pandey, Apurv and Kadayinti, Naveen},
booktitle={2024 IEEE Asia Pacific Conference on Circuits and Systems (APCCAS)}, 
title={TRNG Based on Multiple Entropy Sources Using CTDSM}, 
year={2024},
volume={},
number={},
pages={534-538},
doi={10.1109/APCCAS62602.2024.10808739}
}


@INPROCEEDINGS{pramod_apscon23,
bibtex_show={true},
preview={ufet-force.png},
abbr={APSCON},
award_name={About this paper},
award={This paper presents a novel sub-\mu m U-channel suspended gate SOIFET (USG-SOIFET) based nano-force sensor. The paper discusses how U-channel can mitigate pseudo short channel effects present in suspended gate FET (SGFET). USGFETs with channel length as low as 0.95 µm with an air-gap of 200 nm are shown. This helps in improving the sensitivity of USG-SOIFET and makes it a suitable candidate to detect forces in the nano-newton range. The air-gap values for different forces are obtained from the finite element method (FEM) simulation of MEMS structure and used as input to TCAD for USG-SOIFET simulations to get the final sensor response.},
website={https://doi.org/10.1109/APSCON56343.2023.10101320},
author={Martha, Pramod and Kadayinti, Naveen and Seena, V.},
booktitle={2023 IEEE Applied Sensing Conference (APSCON)}, 
title={{CMOS-MEMS} Nano Force Sensor with Sub-\mu m {U}-Channel Suspended Gate {SOIFET}}, 
year={2023},
volume={},
number={},
pages={1-3},
doi={10.1109/APSCON56343.2023.10101320},
}

@INPROCEEDINGS{10509952,
bibtex_show={true},
preview={high-gain-ota.png},
abbr={APCCAS},
award_name={About this paper},
award={A technique for calibrating a negative conductance load for impedance cancellation in high gain OTAs is presented in this paper. The basic principle of tuning this negative conductance load is by minimising the steady state error of the OTA that is configured in closed loop in calibration mode. Here the calibration of the negative conductance load is done with the OTA itself and it does not need any replica. This avoids the problem of over-correction due to mismatch.},
website={https://doi.org/10.1109/APCCAS60141.2023.00087},
  author={Marinaik, Mayur S. and Kadayinti, Naveen},
  booktitle={2023 IEEE Asia Pacific Conference on Circuits and Systems (APCCAS)},
  title={Mismatch Tolerant Negative Conductance Load Tuning for High Gain OTAs},
  year={2023},
  volume={},
  number={},
  pages={363-366},
  keywords={Circuits and systems;Simulation;Asia;Calibration;Steady-state;Impedance;Gain;High gain OTA;negative conductance;impedance cancellation},
  doi={10.1109/APCCAS60141.2023.00087}}

@INPROCEEDINGS{naveen_iscas22,
bibtex_show={true},
preview={iscas2022.png},
abbr={ISCAS},
award_name={About this paper},
award={A Gm-C based variable bandwidth all pass filter (APF) as true time delay element is presented in this paper. A cascade of low order APF's is used whose group delay is varied by modulating the Gm of its constituent transconductors. This method avoids the need for high quality varactors, and does not require a large range of capacitance values resulting in design simplicity and reduced power consumption. The proposed design is implemented in TSMC 65 nm technology. Simulation results show that the delay element with 3 stages of third order APF maintains uniform magnitude response with the delayrange-bandwidth product of 0.8 and power/delay-range factor of 0.04 mW/ps upto bandwidth of 1 GHz.},
website={https://doi.org/10.1109/ISCAS48785.2022.9937466},
author={Marinaik, Mayur S. and Maheshwarappa, Ganga K. and Kadayinti, Naveen},
booktitle={2022 IEEE International Symposium on Circuits and Systems (ISCAS)}, 
title={A True Time Delay Element using Cascaded Variable Bandwidth All Pass Filters}, 
year={2022},
volume={},
number={},
pages={3473-3477},
doi={10.1109/ISCAS48785.2022.9937466}}


@INPROCEEDINGS{pramod_inertial21,
bibtex_show={true},
preview={inertial2021.png},
abbr={INERTIAL},
award_name={About this paper},
award={Design of transistor based MEMS sensors (like suspended gate transistors) is quite challenging due to the diverse phenomena involved in their operation. The sensor's output depends on the mechanical structure of the device, the process steps used for the transistor fabrication, and of course - the circuit in which the transistor is used. In this paper, we show how we can design and simulate such a transistor using standard tools for (i) mechanical design, (ii) MOSFET process simulation, (iii) MOSFET device simulation and (iv) circuit simulation; by using a look-up-table model based approach for interfacing the different domain analyses. An example design of an accelerometer sensor with a vertically movable gate transistor is designed and simulated to demonstrate the proposed modeling technique.},
website={https://doi.org/10.1109/INERTIAL51137.2021.9430485},
author={Martha, Pramod and Sebastian, Anju and Seena, V. and Kadayinti, Naveen},
booktitle={2021 IEEE International Symposium on Inertial Sensors and Systems (INERTIAL)}, 
title={A Technique for Modeling and Simulating Transistor Based {MEMS} Sensors}, 
year={2021},
volume={},
number={},
pages={1-2},
doi={10.1109/INERTIAL51137.2021.9430485}}

@INPROCEEDINGS{naveen_iscas17,
bibtex_show={true},
preview={iscas.png},
abbr={ISCAS},
award_name={About this paper},
award={In this work, we investigate the effect of timing jitter on the settling time of mesochronous clock re-timing circuits. While the effect of jitter on the BER of synchronizers had been well studied, its effect on settling time had not received attention. The synchronizer system is modeled as a 1 dimensional Markov chain and used to analyze different types of jitter. The paper also proposes techniques of reducing the settling time.},
website={https://doi.org/10.1109/ISCAS.2017.8050694},
author={N. Kadayinti and A. J. {Budkuley} and D. K. {Sharma}},  
booktitle={Proc. IEEE Int. Symp. Circuits and Systems (ISCAS)},
title={Settling time of mesochronous clock re-timing circuits in the presence of timing jitter},   
year={2017},  
volume={},  
number={},  
pages={1-4},
url={https://doi.org/10.1109/ISCAS.2017.8050694},
}


@INPROCEEDINGS{naveen_vlsi17,
bibtex_show={true},
preview={cdr-block.png},
abbr={VLSID},
award_name={About this paper},
award={In this paper we reported a clock retiming circuit for low swing interconnects. The design uses a coarse + fine phase correction scheme. The coarse phase correction is done using a DLL and a control loop that picks the phase closest to the center of the data eye. The fine correction is performed using a VCDL which generates the actual sampling clock. Clock domain transfer from the sampling clock to the receiver clock domain is included in the design. The circuit was fabricated and tested in 130 nm CMOS.},
website={https://doi.org/10.1109/VLSID.2017.12},
author={N. Kadayinti and Baghini, M.S. and Sharma, D.K.},
booktitle =  "Proc. 30th IEEE Conf. VLSI Design",
title={A Clock Retiming Circuit for Repeaterless Low Swing On-Chip Interconnects},
year={2017}, 
pages={15-20},
url={https://doi.org/10.1109/VLSID.2017.12}, 
}

@INPROCEEDINGS{mahadev_vlsi17,
bibtex_show={true},
preview={skewm.png},
abbr={VLSID},
award_name={About this paper},
award={A technique for measuring clock skew between two remote nodes in a chip is reported in this paper. Sub-sampling is used to generate time amplified signals with amplified skew. Since timing variations are typically very slow, this ends up oversampling the skew between the input clocks. Using this oversampling in the converter, a Delta-Sigma Time to Digital converter is constructed. The paper also discusses an all digital implementation of this concept, with negligible penalty in performance.},
website={https://doi.org/10.1109/VLSID.2017.41},
author={M. Shirwaikar and N. Kadayinti and Sharma, D.K.},
booktitle =  "Proc. 30th IEEE Conf. VLSI Design",
title={Clock Skew Measurement using an All-Digital Sigma-Delta Time to Digital Converter},
year={2017}, 
pages={321-326}, 
url={https://doi.org/10.1109/VLSID.2017.41},
}


@INPROCEEDINGS{naveen-date16,
bibtex_show={true},
preview={scantest.png},
abbr={DATE},
award_name={About this paper},
award={Testability is very important for high volume VLSI designs. Repeaterless low swing interconnects have been shown to be a promising alternative to repeater inserted links for continued interconnect performance scaling. However, these techniques use low swing and mixed signal circuits and their testability is not straightforward. We have reported some simple techniques for testing these mixed signal circuits using techniques established for testing digital circuits, like scan test and BIST with digital I/O's. The fault coverage is evaluated for an example design.},
website={https://ieeexplore.ieee.org/document/7459375},
arxiv={1511.06726},
author={N. Kadayinti and D. K. Sharma},
booktitle={Proc. Design, Automation and Test in Europe (DATE)},
title={Testable design of repeaterless low swing on-chip interconnect},
year={2016},
pages={563-566},
month={March},
url={http://ieeexplore.ieee.org/document/7459375/},
}


